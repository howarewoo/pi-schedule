{
  "name": "@howarewoo/pi-schedule",
  "version": "0.1.0",
  "description": "Pi coding agent extension for session-scoped cron jobs that wake the session with a scheduled prompt.",
  "keywords": [
    "cron",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "schedule"
  ],
  "homepage": "https://github.com/howarewoo/pi-schedule#readme",
  "bugs": {
    "url": "https://github.com/howarewoo/pi-schedule/issues"
  },
  "license": "MIT",
  "author": "Adam Woo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howarewoo/pi-schedule.git"
  },
  "files": [
    "index.ts",
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "npm run lint -- --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "test:package": "node scripts/test-package.mjs",
    "release:check": "node scripts/release-notes.mjs",
    "changelog:generate": "node scripts/generate-changelog.mjs",
    "pr-title:check": "node scripts/check-pr-title.mjs"
  },
  "dependencies": {
    "croner": "11.0.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@types/node": "26.6.6",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typebox": "1.4.7",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
